@echo off
:: Включаем поддержку UTF-8 для красивых символов в консоли
chcp 65001 >nul
title ⚔️ Турнирная Арена - Umbreliana
:: Ставим агрессивный красно-черный цвет терминала
color 04

echo ===================================================
echo      СИСТЕМА УПРАВЛЕНИЯ ТУРНИРОМ (КОННОР v2.0)
echo ===================================================
echo.

:loop
echo [ %time% ] 🚀 Запуск ядра Турнирной Арены...
:: Запускаем сам питон-скрипт
python main.py

:: Если скрипт дошел до этой строчки — значит main.py крашнулся или ты его остановил
echo.
echo [ %time% ] ⚠️ ВНИМАНИЕ: СЕРВЕР АРЕНЫ УПАЛ ИЛИ БЫЛ ОСТАНОВЛЕН!
echo 🔄 Автоматический перезапуск через 5 секунд...
echo 🛑 (Чтобы остановить навсегда, быстро нажми CTRL+C)

:: Ждем 5 секунд, чтобы не спамить перезапусками, если ошибка постоянная
timeout /t 5 /nobreak >nul
echo.
goto loop